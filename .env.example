# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
# Server only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=<service_role key>

# Where the static app (GitHub Pages / Capacitor) finds the API routes, e.g. https://<app>.vercel.app
NEXT_PUBLIC_API_BASE=

# Public URL of the web app (used in invitation links)
NEXT_PUBLIC_APP_URL=https://<your-domain>

# Free-plan photo limit shown in the UI; "off" while testing. The real limit is
# public.app_settings.free_photo_limit in the database.
NEXT_PUBLIC_FREE_PHOTO_LIMIT=off

# RevenueCat
REVENUECAT_WEBHOOK_AUTH=<long random string, same value in RevenueCat webhook "Authorization header">
REVENUECAT_SECRET_API_KEY=<sk_... secret API key, optional (enables /api/billing/sync)>
REVENUECAT_ENTITLEMENT_ID=premium
REVENUECAT_IGNORE_SANDBOX=false

# Largest backup ZIP built or accepted (bytes)
BACKUP_ZIP_MAX_BYTES=314572800

# RevenueCat public SDK keys for the native app
NEXT_PUBLIC_REVENUECAT_ANDROID_KEY=
NEXT_PUBLIC_REVENUECAT_IOS_KEY=

# Test-phase OTA: the Android app loads this URL instead of the bundled web app (CI sets it)
# CAP_LIVE_URL=https://<owner>.github.io/Family-Tree/
